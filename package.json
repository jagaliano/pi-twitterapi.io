{
  "name": "pi-twitterapi.io",
  "version": "0.2.0",
  "description": "twitterapi.io-backed X/Twitter search extension for pi coding agent",
  "author": "José Antonio Galiano Sandoval",
  "keywords": [
    "pi-package",
    "pi",
    "twitter",
    "twitterapi.io",
    "x"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jagaliano/pi-twitterapi.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagaliano/pi-twitterapi.io.git"
  },
  "bugs": {
    "url": "https://github.com/jagaliano/pi-twitterapi.io/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "!docs/video-spike.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/jagaliano/pi-twitterapi.io/main/preview.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@earendil-works/pi-tui": "^1.0.2",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typebox": "^1.3.34",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
