{
  "name": "pi-twitterapi.io",
  "version": "0.1.0",
  "description": "twitterapi.io-backed X/Twitter search extension for pi coding agent",
  "keywords": [
    "pi-package",
    "pi",
    "twitter",
    "twitterapi.io",
    "x"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jagaliano/pi-twitterapi.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagaliano/pi-twitterapi.io.git"
  },
  "bugs": {
    "url": "https://github.com/jagaliano/pi-twitterapi.io/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "tsx --test src/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.9.4",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2 <2",
    "@earendil-works/pi-tui": ">=0.99.2 <2",
    "@sinclair/typebox": "*"
  }
}
